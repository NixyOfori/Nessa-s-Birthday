<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>For Vanessa 🎂</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Nunito:wght@400;600;700&family=Playfair+Display:ital,wght@1,600;1,700&display=swap" rel="stylesheet">
<style>
:root{--sky:#8fd3ff;--ice:#dbeeff;--deep:#02050d;--navy:#14284a;--gold:#d9b86a;--soft:#8fb2d1;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;color:var(--ice);text-align:center;overflow-x:hidden;
background:radial-gradient(ellipse at 50% -10%,#123a73 0%,#0a1c3a 40%,var(--deep) 100%) fixed;
font-family:"Nunito",system-ui,sans-serif}
canvas{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:5}
.mote{position:fixed;bottom:-20px;border-radius:50%;background:radial-gradient(#bfe6ff,transparent 70%);opacity:.55;
pointer-events:none;z-index:0;animation:up linear infinite}
@keyframes up{to{transform:translate(var(--dx),-112vh)}}
.sp{position:fixed;width:6px;height:6px;margin:-3px 0 0 -3px;border-radius:50%;background:#d7efff;box-shadow:0 0 9px var(--sky);
pointer-events:none;z-index:9;animation:sp .8s forwards}
@keyframes sp{to{opacity:0;transform:translateY(14px) scale(.2)}}
main{position:relative;z-index:1;max-width:520px;margin:0 auto;padding:30px 20px;min-height:100vh;display:flex;flex-direction:column;
justify-content:center;align-items:center;gap:18px}
main.top{justify-content:flex-start;padding-top:30px;padding-bottom:90px}
main>*:not(#stage){animation:rise .9s ease both}
@keyframes rise{from{opacity:0;transform:translateY(12px)}}
h1,h2{font-family:"Playfair Display",Georgia,serif;font-style:italic;font-weight:700;color:var(--sky);margin:0;line-height:1.2}
h1{font-size:clamp(32px,9vw,44px)}
h2{font-size:clamp(25px,7vw,32px)}
p{margin:4px 0;font-size:clamp(16px,4.4vw,18px);line-height:1.6}
.soft{color:var(--soft);font-size:15px}
.hand{font-family:"Caveat","Segoe Script",cursive;font-size:clamp(26px,7vw,32px);color:#bfe6ff;line-height:1.25}
.lord{font-family:"Caveat",cursive;font-size:29px;color:var(--gold);font-weight:700}
svg.sq{display:block;margin:-6px auto 0;opacity:.85}
button{font:inherit;font-weight:700;font-size:16px;padding:13px 26px;border:0;border-radius:999px;cursor:pointer;color:#06182f;
background:linear-gradient(135deg,#c4e8ff,#6cbcf5);box-shadow:0 6px 20px rgba(100,180,255,.28);transition:transform .2s,box-shadow .2s}
button:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(100,180,255,.4)}
button:active{transform:scale(.97)}
#stage{position:relative;width:100%;height:330px}
#mv{position:absolute;transform:translate(-50%,-50%);max-width:62%;transition:left .55s cubic-bezier(.5,1.4,.5,1),top .55s cubic-bezier(.5,1.4,.5,1)}
#mv:hover{transform:translate(-50%,-50%)}
#mus{position:fixed;top:calc(env(safe-area-inset-top,0px) + 12px);right:12px;z-index:10;width:44px;height:44px;padding:0;display:none;
place-items:center;font-size:20px;background:rgba(143,211,255,.16);box-shadow:none;border:1px solid rgba(143,211,255,.4);color:#fff}
/* cake */
.cake{display:flex;flex-direction:column;align-items:center;margin:8px 0 4px}
.candles{display:flex;gap:30px}
.candle{width:9px;height:34px;background:linear-gradient(#fff,#cfe3f5);border-radius:3px;position:relative}
.flame{position:absolute;top:-21px;left:-3px;width:15px;height:21px;background:radial-gradient(#fffbe8,#ffd27a 55%,#f29a4a);
border-radius:50% 50% 50% 50%/62% 62% 38% 38%;animation:fl .45s ease-in-out infinite alternate;transition:opacity .5s;filter:drop-shadow(0 0 8px #ffd27a)}
.out .flame{opacity:0;animation:none}
@keyframes fl{to{transform:scale(1.1,.92) rotate(4deg)}}
.t{height:36px;border-radius:10px 10px 6px 6px;box-shadow:inset 0 -6px 0 rgba(0,0,0,.08)}
.t1{width:150px;background:#e6f4ff}.t2{width:212px;background:#9fd6ff}.t3{width:274px;background:#4f93d6}
.plate{width:312px;height:10px;background:#dfe9f3;border-radius:50%;box-shadow:0 6px 12px rgba(0,0,0,.5);margin-top:-2px}
.big{font-size:62px}.float{animation:fb 2.4s ease-in-out infinite alternate!important}
@keyframes fb{to{transform:translateY(-12px)}}
/* sticker + scroll */
#holy{width:100%;display:flex;flex-direction:column;align-items:center}
#fig{width:190px;height:218px;transform:rotate(-2deg);animation:sway 4s ease-in-out infinite alternate;
filter:drop-shadow(2px 0 0 #fff) drop-shadow(-2px 0 0 #fff) drop-shadow(0 2px 0 #fff) drop-shadow(0 -2px 0 #fff) drop-shadow(0 8px 12px rgba(0,0,0,.55))}
@keyframes sway{to{transform:rotate(2deg) translateY(-4px)}}
.roll{position:relative;z-index:2;width:100%;height:26px;border-radius:13px;box-shadow:0 5px 10px rgba(0,0,0,.5);
background:linear-gradient(#f6fbff,#cfe3f5 55%,#8fb0cf)}
.roll::before,.roll::after{content:"";position:absolute;top:-4px;width:12px;height:34px;border-radius:6px;background:linear-gradient(90deg,#f0d78f,#b8923f)}
.roll::before{left:-5px}.roll::after{right:-5px}
#r1{margin-top:-22px;transition:margin-top .9s cubic-bezier(.3,1.7,.5,1)}
#r1.held{margin-top:-57px}
#paper{width:94%;height:0;overflow:hidden;position:relative;z-index:1;transition:height .45s ease;
background:linear-gradient(90deg,#d6e8f8,#f4faff 7%,#f4faff 93%,#d6e8f8);box-shadow:inset 0 12px 14px -12px rgba(0,0,0,.35)}
#msg{padding:26px 22px 14px;text-align:left}
#msg h2{text-align:center;color:#1d4f91;margin-bottom:6px}
#msg p{font-family:"Caveat","Segoe Script",cursive;font-size:clamp(23px,6vw,27px);line-height:1.35;color:var(--navy);white-space:pre-line;margin:0 0 16px}
#msg p.sig{text-align:right;color:#1d5fae;font-size:clamp(26px,7vw,31px);font-weight:700}
#msg svg.sq path{stroke:#6cbcf5}
.again{font-family:"Caveat",cursive;font-size:26px;color:var(--soft);animation:breathe 2.6s ease-in-out infinite!important}
@keyframes breathe{50%{opacity:.3}}
</style>
</head>
<body>
<canvas id="c"></canvas>
<button id="mus" aria-label="Toggle music">🔊</button>
<audio id="bgm" src="music.mp3" loop preload="auto"></audio>
<main id="m"></main>
<script>
const m=document.getElementById('m'), cv=document.getElementById('c'), cx=cv.getContext('2d');
const bgm=document.getElementById('bgm'), mus=document.getElementById('mus');
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
const SQ=`<svg class="sq" width="150" height="12" viewBox="0 0 150 12"><path d="M3 7 Q22 0 42 7 T82 7 T122 7 T147 6" fill="none" stroke="#d9b86a" stroke-width="3" stroke-linecap="round"/></svg>`;
let fast=false,musicOn=false;
function size(){cv.width=innerWidth;cv.height=innerHeight}size();addEventListener('resize',size);

/* floating light motes */
for(let i=0;i<18;i++){
  const p=document.createElement('i');p.className='mote';const s=6+Math.random()*14;
  p.style.cssText=`left:${Math.random()*100}%;width:${s}px;height:${s}px;--dx:${(Math.random()-.5)*120}px;`+
  `animation-duration:${14+Math.random()*18}s;animation-delay:${-Math.random()*30}s`;
  document.body.appendChild(p);
}
/* sparkle trail under the finger / cursor */
let lastSp=0;
addEventListener('pointermove',e=>{
  const n=Date.now();if(n-lastSp<45)return;lastSp=n;
  const d=document.createElement('i');d.className='sp';d.style.left=e.clientX+'px';d.style.top=e.clientY+'px';
  document.body.appendChild(d);setTimeout(()=>d.remove(),800);
});
/* music */
function startMusic(){
  if(musicOn)return;musicOn=true;bgm.volume=.35;
  bgm.play().then(()=>{mus.style.display='grid'}).catch(()=>{});
}
mus.onclick=()=>{if(bgm.paused){bgm.play();mus.textContent='🔊'}else{bgm.pause();mus.textContent='🔇'}};

/* confetti */
let parts=[],running=false;
function burst(n=140){
  const cols=['#8fd3ff','#4aa8f0','#dbeeff','#ffffff','#e8c97a','#a9b9ff'],em=['🎂','🎈','🎁','✨','⭐'];
  for(let i=0;i<n;i++)parts.push({x:cv.width/2,y:cv.height*.45,vx:(Math.random()-.5)*13,vy:-Math.random()*13-3,
  s:Math.random()*7+5,c:cols[i%6],r:Math.random()*6,e:Math.random()<.4?em[i%5]:null});
  if(!running){running=true;loop()}
}
function loop(){
  cx.clearRect(0,0,cv.width,cv.height);
  parts.forEach(p=>{p.x+=p.vx;p.y+=p.vy;p.vy+=.28;p.vx*=.995;p.r+=.15;cx.save();cx.translate(p.x,p.y);
    if(p.e){cx.font=(p.s*3)+'px serif';cx.textAlign='center';cx.fillText(p.e,0,0)}
    else{cx.rotate(p.r);cx.fillStyle=p.c;cx.fillRect(-p.s/2,-p.s/2,p.s,p.s*.6)}cx.restore()});
  parts=parts.filter(p=>p.y<cv.height+40);
  if(parts.length)requestAnimationFrame(loop);else{cx.clearRect(0,0,cv.width,cv.height);running=false}
}
/* typing with a human rhythm; also grows the scroll paper as text arrives */
function grow(){
  const p=document.getElementById('paper'),g=document.getElementById('msg');
  if(p&&g){p.style.height=g.offsetHeight+'px';scrollTo({top:document.body.scrollHeight,behavior:'smooth'})}
}
async function type(el,t,sp=35){
  let i=0;
  for(const ch of t){
    el.textContent+=ch;if(++i%4===0)grow();
    await sleep(fast?0:sp*(.55+Math.random()*.9)+(/[.,?!]/.test(ch)?sp*5:0));
  }
  grow();
}

/* 1. runaway button */
function intro(){
  fast=false;m.className='';
  const h=new Date().getHours(),part=h<12?'morning':h<17?'afternoon':'evening';
  m.innerHTML=`<p class="soft">Good ${part}, Vanessa ✨</p>
  <div><h1>Happy Birthday,<br>Vanessa</h1>${SQ}</div>
  <p class="soft">⚠️ Warning: this page has extra love. Proceed at your own risk 😌</p>
  <p class="hand">from: Mr.Ofori</p>
  <div id="stage"><button id="mv" style="left:50%;top:50%">Click here</button></div>`;
  const steps=[
    ["Don't spoil the fun, click me 😏",66,50],
    ["Don't you miss me, click me 🏃",34,50],
    ["You're getting closer, click me👀",50,14],
    ["I am right here! Click me 😂",80,84],
    ["Okay, all jokes aside, this is the final final, click me 🙏",50,50]
  ];
  let i=0;const b=document.getElementById('mv');
  b.onclick=()=>{
    startMusic();
    if(i>=steps.length){wish();return}
    const [t,x,y]=steps[i++];b.textContent=t;b.style.left=x+'%';b.style.top=y+'%';
  };
}

/* 2. wish + cake */
async function wish(){
  m.className='';
  m.innerHTML=`<h2 id="w"></h2><p class="lord" id="l"></p>
  <div class="cake" id="ck" style="opacity:0;transition:opacity 1.2s"><div class="candles">
  <div class="candle"><div class="flame"></div></div><div class="candle"><div class="flame"></div></div><div class="candle"><div class="flame"></div></div></div>
  <div class="t t1"></div><div class="t t2"></div><div class="t t3"></div><div class="plate"></div></div>
  <button id="b" style="display:none">Blow out the candles 💨</button>
  <p class="soft" id="h" style="display:none">☝️ click to blow the candles</p>`;
  await type(document.getElementById('w'),'Make a wish, baby girl 💖 (Matthew 7:7)',50);
  await sleep(500);
  await type(document.getElementById('l'),'The Lord is listening 🙏',55);
  await sleep(500);
  document.getElementById('ck').style.opacity=1;await sleep(1200);
  const b=document.getElementById('b'),h=document.getElementById('h');
  b.style.display='';h.style.display='';
  b.onclick=async()=>{
    b.style.display='none';h.style.display='none';
    document.getElementById('ck').classList.add('out');
    await sleep(800);burst(160);await sleep(2000);
    b.textContent='💌 Click here to read';b.style.display='';
    b.onclick=message;
  };
}

/* 3. the scroll message */
const FIG=`<svg id="fig" viewBox="0 0 200 230" aria-label="Jesus holding a scroll">
<circle cx="100" cy="56" r="46" fill="#ffe9a8" fill-opacity=".4" stroke="#f0c85a" stroke-width="4"/>
<path d="M60 64C56 22 100 14 100 14S144 22 140 64L146 128C124 112 76 112 54 128Z" fill="#5a3b25"/>
<path d="M44 128Q100 104 156 128L170 222H30Z" fill="#f4faff" stroke="#bcd8ee" stroke-width="2"/>
<path d="M94 116H106L116 222H84Z" fill="#8fd3ff"/>
<ellipse cx="100" cy="60" rx="27" ry="33" fill="#efc7a1"/>
<path d="M74 66Q76 104 100 110Q124 104 126 66Q114 84 100 84Q86 84 74 66Z" fill="#5a3b25"/>
<path d="M86 56q6-5 12 0M102 56q6-5 12 0" stroke="#3a2616" stroke-width="2.6" fill="none" stroke-linecap="round"/>
<path d="M100 60q-3 8 1 10" stroke="#d29c78" stroke-width="2" fill="none" stroke-linecap="round"/>
<path d="M93 78q7 5 14 0" stroke="#e9b48f" stroke-width="2.6" fill="none" stroke-linecap="round"/>
<path d="M52 126Q22 150 38 184L62 180Q56 156 80 134Z" fill="#f4faff" stroke="#bcd8ee" stroke-width="2"/>
<path d="M148 126Q178 150 162 184L138 180Q144 156 120 134Z" fill="#f4faff" stroke="#bcd8ee" stroke-width="2"/>
<circle cx="50" cy="184" r="10" fill="#efc7a1"/><circle cx="150" cy="184" r="10" fill="#efc7a1"/></svg>`;
const P=[
["h",`Happy Birthday Vanessa Naana Darkwa.`],
["p",`On this day an amazing person was born, lucky me to know her. That's how they normally start their wishes, rightttttttttt? But I'll pass and I'm different`],
["p",`My forever baby girl, the bone of my bone, the one who used to run away from me in the past. (By this time you're saying, "Not today") So yes, not today`],
["p",`I just want to wish you a happy birthday, but this time with a different style and a little skills, cause as for me, I am extra and thats on period.`],
["p",`Another birthday and you look amazing, in better shape and glowing in the face of God. The celebration is all for you today and I hope and pray you really enjoy your day to the fullest`],
["p",`You've come a long way and you'll still continue to move forward (2003 to now is not a joke.) You deserve a day filled with genuine happiness, laughter and the goodness of GOD`],
["p",`May your dreams take flight and your aspirations be realized. You are plus one today. Today is your birthday, I would have sung but...`],
["p",`I wish for you a world of beautiful moments, adventure, endless happiness, good news, good health, blessings upon you and your family and the Lord's cover over you now and forever.`],
["p",`Thank you for being the wonderful person you are. Happy birthday again. Here's to celebrating you and all the incredible moments that lie ahead of you, I really appreciate you`],
["p",`I'm available whenever you decide, a dinner outing and also an arcade activity\nHave a good day, Psalm 20:4`],
["s",`With love & lots of joy,\nEmmanuel Nana Kojo Ofori 💙`]
];
async function message(){
  fast=false;m.className='top';
  m.innerHTML=`<p class="hand" id="cap">A little something for you…</p>
  <div id="holy">${FIG}<div class="roll held" id="r1"></div>
  <div id="paper"><div id="msg"></div></div><div class="roll" id="r2" style="display:none"></div></div>`;
  m.onclick=()=>{fast=true};
  await sleep(2200);
  document.getElementById('r1').classList.remove('held');   /* he lets go of the scroll */
  if(navigator.vibrate)navigator.vibrate(40);
  document.getElementById('cap').textContent='Let it roll ✨';
  await sleep(1000);
  document.getElementById('r2').style.display='';
  const box=document.getElementById('msg');
  for(const [k,t] of P){
    const el=document.createElement(k==='h'?'h2':'p');if(k==='s')el.className='sig';
    box.appendChild(el);await type(el,t,20);
    if(k==='h')box.insertAdjacentHTML('beforeend',SQ+'<div style="height:14px"></div>');
    grow();await sleep(fast?0:380);
  }
  m.onclick=null;
  const b=document.createElement('button');b.textContent='Next 🎁';b.onclick=gift;
  m.appendChild(b);b.scrollIntoView({behavior:'smooth',block:'center'});
}

/* 4. gift + loop */
async function gift(){
  fast=false;m.className='';m.onclick=null;
  m.innerHTML=`<div class="big float">🎁</div><h2 id="g"></h2><p class="hand" id="e"></p>
  <p class="again" id="r" style="display:none">Read me again</p><button id="b" style="display:none">↺ Play again</button>`;
  burst(70);
  await type(document.getElementById('g'),'Your gift is coming soon.',55);await sleep(600);
  await type(document.getElementById('e'),'Enjoy your day, Nessa 💙',55);await sleep(900);
  document.getElementById('r').style.display='';await sleep(700);
  const b=document.getElementById('b');b.style.display='';b.onclick=intro;
}
intro();
</script>
</body>
</html>